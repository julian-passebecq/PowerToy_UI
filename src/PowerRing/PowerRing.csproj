<Project Sdk="Microsoft.NET.Sdk">
  <!-- Power Ring: a small, always-ready radial launcher (tray + hotkey). Separate from Power Ops on purpose: it starts in
       a fraction of a second and stays light; Power Ops is opened from it for bigger work. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PowerRing</AssemblyName>
    <RootNamespace>PowerRing</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
    <!-- The DPI mode is a WPF app setting (manifest), not a WinForms one: WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Small always-running tray app: workstation GC without the background GC thread keeps the idle footprint low. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, Color...: keep WinForms types fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerRing.Core\PowerRing.Core.csproj" />
  </ItemGroup>
</Project>
