<Application x:Class="JUtility.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6577" />

    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Margin" Value="3" />
    </Style>
  </Application.Resources>
</Application>
