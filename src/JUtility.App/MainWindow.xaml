<Window x:Class="JUtility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J Utility Palette · Power Ops"
        Width="1440" Height="900" MinWidth="360" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}">
  <Window.Resources>
    <Style x:Key="PrimaryNavButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EAF3FF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#DCEBFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryNavButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#F0F5FB"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E3EDF9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WorkspaceTabControlStyle" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="SecondaryNavTemplate">
      <Button Style="{StaticResource SecondaryNavButtonStyle}" Tag="{Binding Key}" Click="SecondaryNav_Click" AutomationProperties.Name="{Binding Label}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}"/>
          <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="8" Padding="6,1">
            <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
          </Border>
        </Grid>
      </Button>
    </DataTemplate>

    <HierarchicalDataTemplate x:Key="ProjectTreeTemplate" ItemsSource="{Binding Children}">
      <DockPanel Margin="1,2">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
        <Border Background="#EEF2F7" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
        </Border>
      </DockPanel>
    </HierarchicalDataTemplate>

    <DataTemplate x:Key="QuickRibbonTemplate">
      <Button Tag="{Binding}" Click="QuickRibbon_Click" Padding="9,6" Margin="4,0" MinWidth="104" Background="White" BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Subtitle}">
        <StackPanel Orientation="Horizontal">
          <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Accent}" Margin="0,0,8,0">
            <TextBlock Text="{Binding Glyph}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Power Ops" FontSize="18" FontWeight="SemiBold"/>
            <Border Background="#EAF3FF" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
              <TextBlock Text="J Utility Palette" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Text="Repositories · portals · resources · capture · clipboard" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </StackPanel>

        <WrapPanel HorizontalAlignment="Right">
          <Button Content="Sidebar" Click="Sidebar_Click"/>
          <Button Content="Compact" Click="Compact_Click"/>
          <Button Content="Expanded" Click="Expanded_Click"/>
          <TextBlock Text="Window" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox Width="132"
                    ItemsSource="{Binding WindowBehaviorOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding WindowBehavior, Mode=TwoWay}"
                    SelectionChanged="WindowBehavior_Changed"/>
          <CheckBox x:Name="TemporaryPinCheck" Content="Keep open" Margin="8,0,4,0" VerticalAlignment="Center"
                    Checked="TemporaryPin_Changed" Unchecked="TemporaryPin_Changed"/>
          <Button Content="Save" Click="Save_Click"/>
        </WrapPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer x:Name="SidebarPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="10">
        <StackPanel>
          <TextBlock Text="Quick access" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Open a portal, copy a snippet, or capture something, then get out of the way." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

          <DockPanel Margin="0,8,0,4">
            <TextBlock Text="Portals" FontWeight="SemiBold" FontSize="14"/>
            <Button Content="+" Width="34" HorizontalAlignment="Right" Click="AddPortal_Click" AutomationProperties.Name="Add portal"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Portals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,3">
                  <DockPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    </StackPanel>
                    <Button Content="Open" Tag="{Binding MainUrl}" Click="OpenUrl_Click" HorizontalAlignment="Right"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Margin="0,10"/>

          <DockPanel Margin="0,4">
            <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="14"/>
            <Button Content="+" Width="34" HorizontalAlignment="Right" Click="AddResource_Click" AutomationProperties.Name="Add resource"/>
          </DockPanel>
          <ItemsControl x:Name="SidebarResourceList" ItemsSource="{Binding Resources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,3">
                  <DockPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Provider}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    </StackPanel>
                    <Button Content="Open" Tag="{Binding Url}" Click="OpenUrl_Click" HorizontalAlignment="Right"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Margin="0,10"/>

          <DockPanel Margin="0,4">
            <TextBlock Text="Clipboard" FontWeight="SemiBold" FontSize="14"/>
            <Button Content="+" Width="34" HorizontalAlignment="Right" Click="AddSnippet_Click" AutomationProperties.Name="Add clipboard snippet"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding ClipboardSnippets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,3">
                  <DockPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    </StackPanel>
                    <Button Content="Copy" Tag="{Binding Text}" Click="CopyValue_Click" HorizontalAlignment="Right"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Margin="0,10"/>

          <DockPanel Margin="0,4">
            <TextBlock Text="Capture" FontWeight="SemiBold" FontSize="14"/>
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="+ URL" Click="CaptureClipboardUrl_Click" ToolTip="Create a bookmark from the URL currently on the clipboard"/>
              <Button Content="+ Capture" Click="AddNote_Click"/>
            </WrapPanel>
          </DockPanel>
          <ItemsControl x:Name="SidebarCaptureList" ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#FFFBEA" BorderBrush="#E6DFAF" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,3">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Kind}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="PowerOpsShell">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FBFCFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Width="185" Margin="4,0,8,0">
              <TextBlock x:Name="CurrentModuleTitle" Text="Dashboard" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="CurrentModuleSubtitle" Text="Overview and recent work" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" x:Name="QuickAddButton" Content="+ Add" Click="QuickAdd_Click" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right"
                     x:Name="ShellSearchBox"
                     Width="250"
                     Height="32"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     ToolTip="Search the current module (Ctrl+K)"
                     AutomationProperties.Name="Search current module"
                     TextChanged="ShellSearchBox_TextChanged"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Search"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="8,0,0,0"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="QuickRibbon" ItemTemplate="{StaticResource QuickRibbonTemplate}" AutomationProperties.Name="Quick actions">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PrimaryNavColumn" Width="185"/>
            <ColumnDefinition x:Name="SecondaryNavColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10">
            <DockPanel>
              <StackPanel x:Name="PrimaryNavPanel" DockPanel.Dock="Top" AutomationProperties.Name="Primary navigation">
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Dashboard" Click="PrimaryNav_Click" Content="▦  Dashboard" AutomationProperties.Name="Dashboard"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Repository Hub" Click="PrimaryNav_Click" Content="◫  Repository Hub" AutomationProperties.Name="Repository Hub"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Portals" Click="PrimaryNav_Click" Content="↗  Portal Launcher" AutomationProperties.Name="Portal Launcher"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Resources" Click="PrimaryNav_Click" Content="◆  Resource Hub" AutomationProperties.Name="Resource Hub"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Capture" Click="PrimaryNav_Click" Content="✎  Capture" AutomationProperties.Name="Capture"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Clipboard" Click="PrimaryNav_Click" Content="▣  Clipboard" AutomationProperties.Name="Clipboard"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Prompt Builder" Click="PrimaryNav_Click" Content="⌘  Prompt Builder" AutomationProperties.Name="Prompt Builder"/>
                <Separator Margin="0,8"/>
                <Button Style="{StaticResource PrimaryNavButtonStyle}" Tag="Settings" Click="PrimaryNav_Click" Content="⚙  Settings" AutomationProperties.Name="Settings"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,2">
                <TextBlock Text="Local-first workspace" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Text="No cloud sync required" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock x:Name="SecondaryTitle" Text="Overview" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="SecondaryHint" Text="Choose a section" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,8"/>
              </StackPanel>

              <Grid Grid.Row="1">
                <TreeView x:Name="RepositoryTree"
                          AutomationProperties.Name="Repository categories"
                          Visibility="Collapsed"
                          ItemTemplate="{StaticResource ProjectTreeTemplate}"
                          SelectedItemChanged="RepositoryTree_SelectedItemChanged"
                          BorderThickness="0"
                          Background="Transparent"/>
                <ScrollViewer x:Name="SecondaryNavScroller" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SecondaryNav" ItemTemplate="{StaticResource SecondaryNavTemplate}" AutomationProperties.Name="Module filters"/>
                </ScrollViewer>
              </Grid>

              <StackPanel Grid.Row="2" x:Name="RepoSavedListsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Separator Margin="0,0,0,8"/>
                <TextBlock Text="SAVED LISTS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/>
                <DockPanel Margin="0,5,0,6">
                  <TextBox x:Name="NewRepoListName" MinWidth="112" ToolTip="List name" AutomationProperties.Name="Saved repository list name"/>
                  <Button Content="Save" Click="SaveRepoList_Click"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding RepositoryLists}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6" Margin="0,2">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Items.Count}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                          </DockPanel>
                          <WrapPanel>
                            <Button Content="Load" Tag="{Binding}" Click="LoadRepoList_Click"/>
                            <Button Content="Copy" Tag="{Binding}" Click="CopyRepoList_Click"/>
                            <Button Content="Open" Tag="{Binding}" Click="OpenRepoList_Click"/>
                            <Button Content="×" Tag="{Binding}" Click="DeleteRepoList_Click" AutomationProperties.Name="Delete saved repository list"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2" Background="{StaticResource PanelBrush}">
            <TabControl x:Name="WorkspacePanel" Style="{StaticResource WorkspaceTabControlStyle}">
              <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="16">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Recent work and quick access. Editing stays inside the dedicated modules." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,14"/>
                    <UniformGrid Columns="5">
                      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="Repositories" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Projects.Count}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="Portals" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Portals.Count}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="Resources" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Resources.Count}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="Captures" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Notes.Count}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="Clipboard" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ClipboardSnippets.Count}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>

                    <DockPanel Margin="4,16,4,6">
                      <StackPanel>
                        <TextBlock Text="Capture board" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="The dashboard view mirrors your Inbox / To-do / Notes / Bookmarks / Read later workflow, with Transcript as the long-text capture type." Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                      </StackPanel>
                      <WrapPanel HorizontalAlignment="Right">
                        <CheckBox Content="Include completed"
                                  IsChecked="{Binding IncludeCompletedCaptures}"
                                  Click="CaptureCompletionFilterChanged_Click"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Button Content="+ URL from clipboard" Click="CaptureClipboardUrl_Click"/>
                        <Button Content="+ Quick capture" Click="AddNote_Click"/>
                      </WrapPanel>
                    </DockPanel>

                    <ItemsControl x:Name="CaptureBoard" Margin="0,0,0,8">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="4" Padding="10" MinHeight="150">
                            <Grid>
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <DockPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right">
                                  <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                              </DockPanel>
                              <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="0,7,0,4">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="0,4">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subject}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Button Grid.Row="2" Content="Open list →" Tag="{Binding Key}" Click="DashboardCaptureKind_Click" HorizontalAlignment="Left"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="4,16,4,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                        <StackPanel>
                          <DockPanel><TextBlock Text="Portals" FontSize="15" FontWeight="SemiBold"/><Button Content="+ Add" HorizontalAlignment="Right" Click="AddPortal_Click"/></DockPanel>
                          <ItemsControl ItemsSource="{Binding Portals}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,5">
                                  <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                  </StackPanel>
                                  <Button Content="Open ↗" Tag="{Binding MainUrl}" Click="OpenUrl_Click" HorizontalAlignment="Right"/>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="Pinned / favorite resources" FontSize="15" FontWeight="SemiBold"/>
                            <Button Content="Resource Hub →" HorizontalAlignment="Right" Tag="Resources" Click="PrimaryNav_Click"/>
                          </DockPanel>
                          <ItemsControl x:Name="DashboardResourceList" ItemsSource="{Binding Resources}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="0,5">
                                  <DockPanel>
                                    <StackPanel>
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                      <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10">
                                        <Run Text="{Binding Provider}"/><Run Text=" · "/><Run Text="{Binding Kind}"/>
                                      </TextBlock>
                                    </StackPanel>
                                    <WrapPanel HorizontalAlignment="Right">
                                      <Button Content="Copy" Tag="{Binding Url}" Click="CopyValue_Click"/>
                                      <Button Content="Open" Tag="{Binding Url}" Click="OpenUrl_Click"/>
                                    </WrapPanel>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="Saved repository lists" FontSize="15" FontWeight="SemiBold"/>
                            <Button Content="Repository Hub →" HorizontalAlignment="Right" Tag="Repository Hub" Click="PrimaryNav_Click"/>
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding RepositoryLists}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="0,5">
                                  <DockPanel>
                                    <StackPanel>
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Items.Count, StringFormat={}{0} repositories}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                    <WrapPanel HorizontalAlignment="Right">
                                      <Button Content="Load" Tag="{Binding}" Click="LoadRepoList_Click"/>
                                      <Button Content="Copy" Tag="{Binding}" Click="CopyRepoList_Click"/>
                                      <Button Content="Open" Tag="{Binding}" Click="OpenRepoList_Click"/>
                                    </WrapPanel>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Repository Hub">
                <Grid Margin="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="Repository Hub" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Text="One project row, four primary links: GitHub, website, server, ChatGPT." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right">
                      <TextBlock x:Name="SelectedRepoCountText" Text="0 selected" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                      <TextBox x:Name="RepoSearchBox" Width="210" ToolTip="Search repository name, description, category, language…" TextChanged="RepoSearch_TextChanged" AutomationProperties.Name="Repository search"/>
                      <Button Content="+ Project" Click="AddProject_Click"/>
                      <Button Content="Sync GitHub" Click="SyncGitHub_Click" ToolTip="Uses the authenticated GitHub CLI when available; otherwise imports public repositories."/>
                      <Button Content="Copy all" Click="CopyAll_Click"/>
                      <Button Content="GitHub" Click="CopyGithubColumn_Click"/>
                      <Button Content="Websites" Click="CopyWebsiteColumn_Click"/>
                      <Button Content="Servers" Click="CopyServerColumn_Click"/>
                      <Button Content="ChatGPT" Click="CopyChatGptColumn_Click"/>
                      <Button Content="Open selected" Click="OpenSelectedRepos_Click"/>
                      <CheckBox Content="Legacy Extra" IsChecked="{Binding ShowExtraColumn}" Checked="ShowExtra_Changed" Unchecked="ShowExtra_Changed" Margin="8,0"/>
                    </WrapPanel>
                  </DockPanel>

                  <DataGrid x:Name="ProjectsGrid" Grid.Row="1" ItemsSource="{Binding Projects}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" Background="White" FrozenColumnCount="2" CellEditEnding="ProjectsGrid_CellEditEnding" AutomationProperties.Name="Repository projects">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="✓" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IncludeInCopyAll, UpdateSourceTrigger=PropertyChanged}"
                                      Click="ProjectIncludeChanged_Click"
                                      HorizontalAlignment="Center"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Project" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                      <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                      <DataGridTextColumn Header="Sub" Binding="{Binding Subcategory, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                      <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="85" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Updated" Binding="{Binding GitHubUpdatedUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="95" IsReadOnly="True"/>
                      <DataGridTemplateColumn Header="GitHub" Width="235">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid MinHeight="48">
                              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <TextBox Text="{Binding RepoUrl, UpdateSourceTrigger=PropertyChanged}" Margin="2" Padding="4,2"/>
                              <DockPanel Grid.Row="1">
                                <CheckBox IsChecked="{Binding CopyRepo, UpdateSourceTrigger=PropertyChanged}" Click="LinkIncludeChanged_Click" ToolTip="Include GitHub URL in Copy All"/>
                                <WrapPanel HorizontalAlignment="Right">
                                  <Button Content="⧉" Tag="{Binding RepoUrl}" Click="CopyValue_Click" Padding="5,2" MinHeight="22"/>
                                  <Button Content="↗" Tag="{Binding RepoUrl}" Click="OpenUrl_Click" Padding="5,2" MinHeight="22" AutomationProperties.Name="Open GitHub repository"/>
                                </WrapPanel>
                              </DockPanel>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <DataGridTemplateColumn Header="Website" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid MinHeight="48">
                              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}" Margin="2" Padding="4,2"/>
                              <DockPanel Grid.Row="1">
                                <CheckBox IsChecked="{Binding CopySite, UpdateSourceTrigger=PropertyChanged}" Click="LinkIncludeChanged_Click" ToolTip="Include website URL in Copy All"/>
                                <WrapPanel HorizontalAlignment="Right">
                                  <Button Content="⧉" Tag="{Binding SiteUrl}" Click="CopyValue_Click" Padding="5,2" MinHeight="22"/>
                                  <Button Content="↗" Tag="{Binding SiteUrl}" Click="OpenUrl_Click" Padding="5,2" MinHeight="22" AutomationProperties.Name="Open website"/>
                                </WrapPanel>
                              </DockPanel>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <DataGridTemplateColumn Header="Server" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid MinHeight="48">
                              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="2" Padding="4,2"/>
                              <DockPanel Grid.Row="1">
                                <CheckBox IsChecked="{Binding CopyServer, UpdateSourceTrigger=PropertyChanged}" Click="LinkIncludeChanged_Click" ToolTip="Include server/hosting URL in Copy All"/>
                                <WrapPanel HorizontalAlignment="Right">
                                  <Button Content="⧉" Tag="{Binding ServerUrl}" Click="CopyValue_Click" Padding="5,2" MinHeight="22"/>
                                  <Button Content="↗" Tag="{Binding ServerUrl}" Click="OpenUrl_Click" Padding="5,2" MinHeight="22" AutomationProperties.Name="Open server or hosting"/>
                                </WrapPanel>
                              </DockPanel>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <DataGridTemplateColumn Header="ChatGPT" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid MinHeight="48">
                              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <TextBox Text="{Binding ChatGptUrl, UpdateSourceTrigger=PropertyChanged}" Margin="2" Padding="4,2"/>
                              <DockPanel Grid.Row="1">
                                <CheckBox IsChecked="{Binding CopyChatGpt, UpdateSourceTrigger=PropertyChanged}" Click="LinkIncludeChanged_Click" ToolTip="Include ChatGPT URL in Copy All"/>
                                <WrapPanel HorizontalAlignment="Right">
                                  <Button Content="⧉" Tag="{Binding ChatGptUrl}" Click="CopyValue_Click" Padding="5,2" MinHeight="22"/>
                                  <Button Content="↗" Tag="{Binding ChatGptUrl}" Click="OpenUrl_Click" Padding="5,2" MinHeight="22" AutomationProperties.Name="Open ChatGPT conversation"/>
                                </WrapPanel>
                              </DockPanel>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>

                      <DataGridTextColumn x:Name="ExtraUrlColumn" Header="Legacy Extra" Binding="{Binding ExtraUrl, UpdateSourceTrigger=PropertyChanged}" Width="150"/>

                      <DataGridTemplateColumn Header="" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <WrapPanel>
                              <Button Content="Copy row" Tag="{Binding}" Click="CopyRow_Click"/>
                              <Button Content="Archive / restore" Tag="{Binding}" Click="ArchiveProject_Click"/>
                              <Button Content="×" Tag="{Binding}" Click="DeleteProject_Click" AutomationProperties.Name="Delete project"/>
                            </WrapPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>

                  <TextBlock Grid.Row="2" Margin="4,8,4,0" Foreground="{StaticResource MutedBrush}" Text="Select a project with ✓ to include every available URL by default. Each link cell has its own bottom-left include box so you can exclude individual URLs without deselecting the project. Saved lists preserve the exact choices."/>
                </Grid>
              </TabItem>

              <TabItem Header="Portals">
                <Grid Margin="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                      <StackPanel>
                        <TextBlock Text="Portal Launcher" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Direct-open services; no selection workflow." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                      <Button Content="+ Portal" HorizontalAlignment="Right" Click="AddPortal_Click"/>
                    </DockPanel>

                    <ListBox x:Name="PortalList" Grid.Row="1" ItemsSource="{Binding Portals}" SelectedItem="{Binding SelectedPortal}" Margin="0,8" MouseDoubleClick="PortalList_MouseDoubleClick" KeyDown="PortalList_KeyDown" AutomationProperties.Name="Portals" AutomationProperties.HelpText="Press Enter to open the selected portal. Press Ctrl+C to copy its URL.">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,4">
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="#EAF3FF" VerticalAlignment="Top">
                                  <TextBlock Text="{Binding IconKey}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                  </StackPanel>
                                  <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                  <TextBlock Text="{Binding MainUrl}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                  <Button Content="Open ↗" Tag="{Binding MainUrl}" Click="OpenUrl_Click"/>
                                  <Button Content="⧉" Tag="{Binding MainUrl}" Click="CopyValue_Click"/>
                                </StackPanel>
                              </Grid>

                              <ItemsControl ItemsSource="{Binding Links}" Margin="42,5,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <DockPanel Margin="0,2">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="{Binding Project}" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                      </StackPanel>
                                      <WrapPanel HorizontalAlignment="Right">
                                        <Button Content="Open" Tag="{Binding Url}" Click="OpenUrl_Click"/>
                                        <Button Content="Copy" Tag="{Binding Url}" Click="CopyValue_Click"/>
                                      </WrapPanel>
                                    </DockPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Delete selected portal" Click="DeletePortal_Click"/>
                  </Grid>

                  <Grid Grid.Column="1" Margin="8,0,0,0" DataContext="{Binding SelectedPortal}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" AutomationProperties.Name="Portal name"/>
                      <WrapPanel>
                        <TextBox Width="190" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" ToolTip="Category" LostFocus="Category_LostFocus" AutomationProperties.Name="Portal category"/>
                        <TextBox Width="120" Text="{Binding IconKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Icon key / short label" AutomationProperties.Name="Portal icon key"/>
                        <CheckBox Content="Pin to top ribbon" IsChecked="{Binding IsPinnedToRibbon}" Margin="8" Click="PortalPinChanged_Click"/>
                        <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Margin="8" Click="PortalFavoriteChanged_Click"/>
                      </WrapPanel>
                      <DockPanel>
                        <TextBox Text="{Binding MainUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Main portal URL" AutomationProperties.Name="Main portal URL"/>
                        <WrapPanel DockPanel.Dock="Right">
                          <Button Content="Open main ↗" Tag="{Binding MainUrl}" Click="OpenUrl_Click"/>
                          <Button Content="Copy" Tag="{Binding MainUrl}" Click="CopyValue_Click"/>
                        </WrapPanel>
                      </DockPanel>
                    </StackPanel>

                    <DockPanel Grid.Row="1" Margin="0,10,0,4">
                      <TextBlock Text="Project-specific sub-links" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Button Content="+ Link" HorizontalAlignment="Right" Click="AddPortalLink_Click"/>
                    </DockPanel>

                    <DataGrid x:Name="PortalLinksGrid" Grid.Row="2" ItemsSource="{Binding Links}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" Background="White" AutomationProperties.Name="Portal project links">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTextColumn Header="Project" Binding="{Binding Project, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTextColumn Header="URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                        <DataGridTemplateColumn Header="Actions" Width="140">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <WrapPanel>
                                <Button Content="Open" Tag="{Binding Url}" Click="OpenUrl_Click"/>
                                <Button Content="Copy" Tag="{Binding Url}" Click="CopyValue_Click"/>
                                <Button Content="×" Tag="{Binding}" Click="DeletePortalLink_Click" AutomationProperties.Name="Delete portal sub-link"/>
                              </WrapPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Margin="4,8,4,0" Foreground="{StaticResource MutedBrush}" Text="Top-ribbon portal icons open the main URL immediately. Sub-links remain attached to this service for project-specific navigation."/>
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="Resources">
                <Grid Margin="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                      <StackPanel>
                        <TextBlock Text="Resource Hub" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Specific folders, repositories, documents and dashboards across your services." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                      <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Import repos" Click="ImportRepositoryResources_Click" ToolTip="Create/update GitHub resource links from Repository Hub"/>
                        <Button Content="+ Clipboard URL" Click="CaptureResourceClipboardUrl_Click" ToolTip="Create a quick link from the current clipboard URL"/>
                        <Button Content="+ Resource" Click="AddResource_Click"/>
                      </WrapPanel>
                    </DockPanel>

                    <ListBox x:Name="ResourceList" Grid.Row="1" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" Margin="0,8" MouseDoubleClick="ResourceList_MouseDoubleClick" KeyDown="ResourceList_KeyDown" AutomationProperties.Name="Resources" AutomationProperties.HelpText="Press Enter to open the selected resource. Press Ctrl+C to copy its URL.">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4">
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <Border Width="34" Height="34" CornerRadius="8" Background="#EAF3FF" VerticalAlignment="Top">
                                <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10">
                                  <Run Text="{Binding Provider}"/><Run Text=" · "/><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Group}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <WrapPanel Grid.Column="2">
                                <Button Content="Open" Tag="{Binding Url}" Click="OpenUrl_Click"/>
                                <Button Content="Copy" Tag="{Binding Url}" Click="CopyValue_Click"/>
                              </WrapPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Delete selected resource" Click="DeleteResource_Click"/>
                  </Grid>

                  <Grid Grid.Column="1" Margin="8,0,0,0" DataContext="{Binding SelectedResource}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" AutomationProperties.Name="Resource name"/>
                      <WrapPanel>
                        <ComboBox Width="180"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ResourceProviderOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Provider"
                                  AutomationProperties.Name="Resource provider"
                                  LostFocus="Category_LostFocus"/>
                        <ComboBox Width="160"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ResourceKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Resource kind"
                                  AutomationProperties.Name="Resource kind"/>
                        <TextBox Width="190" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" ToolTip="Project / group / topic" LostFocus="Category_LostFocus" AutomationProperties.Name="Resource project or group"/>
                        <CheckBox Content="Pin to ribbon" IsChecked="{Binding IsPinned}" Margin="8" Click="ResourceStateChanged_Click"/>
                        <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Margin="8" Click="ResourceStateChanged_Click"/>
                      </WrapPanel>
                      <DockPanel>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="Resource URL" AutomationProperties.Name="Resource URL"/>
                        <WrapPanel DockPanel.Dock="Right">
                          <Button Content="Open ↗" Tag="{Binding Url}" Click="OpenUrl_Click"/>
                          <Button Content="Copy" Tag="{Binding Url}" Click="CopyValue_Click"/>
                        </WrapPanel>
                      </DockPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Notes" FontWeight="SemiBold" Margin="3,10,3,3"/>
                    <TextBox Grid.Row="2" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="3" AutomationProperties.Name="Resource notes"/>

                    <TextBlock Grid.Row="3" Margin="4,8,4,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Use Resource Hub for exact destinations such as a Google Drive folder, Dropbox folder, GitHub repository, Notion page or shared document. Portal Launcher remains for service home pages."/>
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="Capture">
                <Grid Margin="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                      <StackPanel>
                        <TextBlock Text="Capture" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Inbox · To-do · Notes · Bookmarks · Read later · Transcript" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                      <WrapPanel HorizontalAlignment="Right">
                        <CheckBox Content="Include completed"
                                  IsChecked="{Binding IncludeCompletedCaptures}"
                                  Click="CaptureCompletionFilterChanged_Click"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Button Content="+ URL" Click="CaptureClipboardUrl_Click" ToolTip="Create a bookmark from the URL currently on the clipboard"/>
                        <Button Content="+ Capture" Click="AddNote_Click"/>
                        <Button Content="Export all" Click="ExportCaptures_Click"/>
                      </WrapPanel>
                    </DockPanel>

                    <ListBox x:Name="CaptureList" Grid.Row="1" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" Margin="0,8" KeyDown="CaptureList_KeyDown" AutomationProperties.Name="Captures" AutomationProperties.HelpText="Press Enter to edit the selected capture title. Press Ctrl+C to copy the capture.">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="7">
                            <StackPanel>
                              <DockPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Kind}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                              </DockPanel>
                              <TextBlock Text="{Binding Subject}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>

                  <Grid Grid.Column="1" Margin="8,0,0,0" DataContext="{Binding SelectedNote}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <WrapPanel>
                        <ComboBox Width="145"
                                  ItemsSource="{Binding DataContext.CaptureKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Kind}"
                                  SelectionChanged="CaptureKindChanged_Click"
                                  ToolTip="Capture type"
                                  AutomationProperties.Name="Capture type"/>
                        <TextBox x:Name="CaptureTitleBox" Width="330" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" ToolTip="Title" AutomationProperties.Name="Capture title"/>
                      </WrapPanel>
                      <WrapPanel>
                        <TextBox Width="190" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" ToolTip="Subject / category" LostFocus="CaptureSubject_LostFocus" AutomationProperties.Name="Capture subject"/>
                        <ComboBox Width="190"
                                  ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Associated project"
                                  AutomationProperties.Name="Capture project"/>
                        <TextBox Width="190" Text="{Binding Labels, UpdateSourceTrigger=PropertyChanged}" ToolTip="Labels" AutomationProperties.Name="Capture labels"/>
                        <TextBox Width="110" Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" ToolTip="Status" AutomationProperties.Name="Capture status"/>
                        <TextBox Width="110" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" ToolTip="Priority" AutomationProperties.Name="Capture priority"/>
                        <DatePicker Width="145"
                                    SelectedDate="{Binding DataContext.SelectedNoteDueDate, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                    SelectedDateChanged="CaptureDueDateChanged_Click"
                                    ToolTip="Due date"
                                    AutomationProperties.Name="Capture due date"/>
                      </WrapPanel>
                      <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="Source URL" AutomationProperties.Name="Capture source URL"/>
                    </StackPanel>

                    <TextBox x:Name="CaptureBodyBox" Grid.Row="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="3,8" MinHeight="220" AutomationProperties.Name="Capture body"/>

                    <WrapPanel Grid.Row="2">
                      <CheckBox Content="Pinned" IsChecked="{Binding IsPinned}" Margin="6" Click="CaptureItemStateChanged_Click"/>
                      <CheckBox Content="Completed" IsChecked="{Binding IsCompleted}" Margin="6" Click="CaptureItemStateChanged_Click"/>
                      <Button Content="Copy capture" Click="CopyNote_Click"/>
                      <Button Content="Copy URL" Tag="{Binding Url}" Click="CopyValue_Click"/>
                      <Button Content="Open URL" Tag="{Binding Url}" Click="OpenUrl_Click"/>
                      <Button Content="Archive / restore" Click="ArchiveNote_Click"/>
                      <Button Content="Export" Click="ExportSelectedCapture_Click"/>
                      <Button Content="Delete" Click="DeleteCapture_Click"/>
                    </WrapPanel>
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="Clipboard">
                <Grid Margin="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                      <StackPanel>
                        <TextBlock Text="Clipboard Library" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="One-click reusable text and premade prompts" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                      <Button Content="+ Snippet" HorizontalAlignment="Right" Click="AddSnippet_Click"/>
                    </DockPanel>

                    <ListBox x:Name="SnippetList" Grid.Row="1" ItemsSource="{Binding ClipboardSnippets}" SelectedItem="{Binding SelectedSnippet}" Margin="0,8" KeyDown="SnippetList_KeyDown" AutomationProperties.Name="Clipboard snippets" AutomationProperties.HelpText="Press Enter or Ctrl+C to copy the selected snippet.">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="7">
                            <StackPanel>
                              <DockPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Category}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                              </DockPanel>
                              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Delete selected snippet" Click="DeleteSnippet_Click"/>
                  </Grid>

                  <Grid Grid.Column="1" Margin="8,0,0,0" DataContext="{Binding SelectedSnippet}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" AutomationProperties.Name="Clipboard snippet title"/>
                      <WrapPanel>
                        <TextBox Width="190" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" ToolTip="Category" LostFocus="Category_LostFocus" AutomationProperties.Name="Clipboard snippet category"/>
                        <TextBox Width="300" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tags" AutomationProperties.Name="Clipboard snippet tags"/>
                        <CheckBox Content="Pin to top ribbon" IsChecked="{Binding IsPinned}" Margin="8" Click="SnippetPinChanged_Click"/>
                      </WrapPanel>
                    </StackPanel>

                    <TextBox Grid.Row="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="3,8" AutomationProperties.Name="Clipboard snippet text"/>

                    <WrapPanel Grid.Row="2">
                      <Button Content="Copy now" Click="CopySnippet_Click"/>
                      <TextBlock Text="Use Prompt Builder when several modules need to be composed together." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8"/>
                    </WrapPanel>
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="Prompt Builder">
                <Grid Margin="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                      <StackPanel>
                        <TextBlock Text="Prompt Builder" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Compose reusable modules with project variables" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                      <Button Content="+ Module" HorizontalAlignment="Right" Click="AddModule_Click"/>
                    </DockPanel>

                    <ListBox x:Name="PromptModuleList" Grid.Row="1" ItemsSource="{Binding PromptModules}" Margin="0,6" AutomationProperties.Name="Prompt modules">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="5">
                            <StackPanel>
                              <DockPanel>
                                <CheckBox IsChecked="{Binding IsEnabled}" AutomationProperties.Name="Enable prompt module"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Width="170" AutomationProperties.Name="Prompt module title"/>
                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="Category" LostFocus="Category_LostFocus" AutomationProperties.Name="Prompt module category"/>
                                <Button Content="↑" Tag="{Binding}" Click="MoveModuleUp_Click" AutomationProperties.Name="Move prompt module up"/>
                                <Button Content="↓" Tag="{Binding}" Click="MoveModuleDown_Click" AutomationProperties.Name="Move prompt module down"/>
                              </DockPanel>
                              <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" LostFocus="PromptModuleBody_LostFocus" AutomationProperties.Name="Prompt module body"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Variables: {{project}}, {{repo}}, {{site}}, {{server}}, {{chatgpt}}, {{extra}}. Unknown variables remain visible."/>
                  </Grid>

                  <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Text="Compose" FontSize="15" FontWeight="SemiBold"/>
                      <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedPromptProject}" DisplayMemberPath="Name" AutomationProperties.Name="Prompt project context"/>
                      <DockPanel Margin="3,5,3,0">
                        <TextBlock Text="Custom variables" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Refresh" HorizontalAlignment="Right" Click="RefreshPromptVariables_Click"/>
                      </DockPanel>
                      <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PromptVariables}" Margin="3,2,3,4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <DockPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" Width="130" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" ToolTip="Value for this {{variable}} placeholder" AutomationProperties.Name="Prompt variable value"/>
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <WrapPanel>
                        <Button Content="Preview" Click="PreviewPrompt_Click"/>
                        <Button Content="Copy prompt" Click="ComposeCopy_Click"/>
                        <Button Content="Copy + project" Click="ComposeCopyProject_Click"/>
                      </WrapPanel>
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding PromptPreview, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="3,8" AutomationProperties.Name="Prompt preview"/>
                    <TextBlock Grid.Row="2" Text="Recent prompts" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="3" ItemsSource="{Binding RecentPrompts}" AutomationProperties.Name="Recent prompts">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="4">
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" MaxWidth="420"/>
                            </StackPanel>
                            <WrapPanel HorizontalAlignment="Right">
                              <Button Content="Recall" Tag="{Binding}" Click="RecallRecentPrompt_Click"/>
                              <Button Content="Copy" Tag="{Binding}" Click="CopyRecentPrompt_Click"/>
                            </WrapPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Window behavior" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,3"/>
                    <TextBlock Text="Choose whether the utility behaves like a normal window, stays above other apps, or is summoned only when needed." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8"/>
                    <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding WindowBehaviorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding WindowBehavior, Mode=TwoWay}" SelectionChanged="WindowBehavior_Changed" AutomationProperties.Name="Window behavior"/>

                    <TextBlock Text="Summon trigger" FontWeight="SemiBold" Margin="0,14,0,3"/>
                    <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding SummonBindingOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SummonMouseBinding, Mode=TwoWay}" SelectionChanged="SummonBinding_Changed" AutomationProperties.Name="Summon trigger"/>
                    <CheckBox Content="Hide when focus is lost" IsChecked="{Binding HideOnFocusLoss}" Checked="SummonPreference_Changed" Unchecked="SummonPreference_Changed" Margin="0,8,0,0"/>
                    <CheckBox Content="Open near the mouse cursor" IsChecked="{Binding OpenNearCursor}" Checked="SummonPreference_Changed" Unchecked="SummonPreference_Changed"/>
                    <WrapPanel Margin="0,6,0,0">
                      <Button Content="Hide now to test summon" Width="190" Click="HideNow_Click"/>
                      <Button Content="Reset saved window layouts" Width="190" Click="ResetWindowLayouts_Click"/>
                    </WrapPanel>

                    <Separator Margin="0,16,0,12"/>
                    <TextBlock Text="GitHub repository discovery" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Owner / account" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Sync GitHub first tries your local authenticated gh CLI, so private repositories can be discovered without storing a token in the workspace. If gh is unavailable it falls back to public repositories only." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

                    <Separator Margin="0,16,0,12"/>
                    <TextBlock Text="Local-first storage" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Data file" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBox Text="{Binding DataFilePath, Mode=OneWay}" IsReadOnly="True"/>
                    <WrapPanel>
                      <Button Content="Open data folder" Click="OpenDataFolder_Click"/>
                      <Button Content="Export JSON" Click="Export_Click"/>
                      <Button Content="Import JSON" Click="Import_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,5">
      <DockPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="Local JSON · Normal / Topmost / Summon"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
