<Window x:Class="JUtility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J Utility Palette" Width="900" Height="760" MinWidth="360" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PanelBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="J Utility Palette" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Prompts, project links, and temporary notes" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
        <WrapPanel HorizontalAlignment="Right"><Button Content="Sidebar" Click="Sidebar_Click"/><Button Content="Compact" Click="Compact_Click"/><Button Content="Expanded" Click="Expanded_Click"/><CheckBox Content="Pin" Margin="10,0,4,0" VerticalAlignment="Center" IsChecked="{Binding AlwaysOnTop}" Checked="Pin_Changed" Unchecked="Pin_Changed"/><Button Content="Save" Click="Save_Click"/></WrapPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="10">
      <ScrollViewer x:Name="SidebarPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <DockPanel><TextBlock Text="Projects" FontWeight="SemiBold" FontSize="15"/><Button Content="+" Width="34" HorizontalAlignment="Right" Click="AddProject_Click"/></DockPanel>
          <ItemsControl ItemsSource="{Binding Projects}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,4"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><WrapPanel><Button Content="Repo" Tag="{Binding RepoUrl}" Click="OpenUrl_Click"/><Button Content="Copy R" Tag="{Binding RepoUrl}" Click="CopyValue_Click"/><Button Content="Site" Tag="{Binding SiteUrl}" Click="OpenUrl_Click"/><Button Content="Copy S" Tag="{Binding SiteUrl}" Click="CopyValue_Click"/><Button Content="Copy row" Tag="{Binding}" Click="CopyRow_Click"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Separator Margin="0,8"/>
          <TextBlock Text="Prompt modules" FontWeight="SemiBold" FontSize="15"/>
          <ItemsControl ItemsSource="{Binding PromptModules}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Title}" IsChecked="{Binding IsEnabled}" Margin="3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Content="Compose + copy" Click="ComposeCopy_Click"/>
          <Separator Margin="0,8"/>
          <DockPanel><TextBlock Text="Notes" FontWeight="SemiBold" FontSize="15"/><Button Content="+" Width="34" HorizontalAlignment="Right" Click="AddNote_Click"/></DockPanel>
          <ItemsControl ItemsSource="{Binding Notes}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFFBEA" BorderBrush="#E6DFAF" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,4"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="70" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <TabControl x:Name="WorkspacePanel" Background="Transparent" BorderThickness="0">
        <TabItem Header="Projects"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,8"><WrapPanel><Button Content="Add project" Click="AddProject_Click"/><Button Content="Copy all included" Click="CopyAll_Click"/></WrapPanel><CheckBox Content="Show Extra" IsChecked="{Binding ShowExtraColumn}" Checked="ShowExtra_Changed" Unchecked="ShowExtra_Changed" HorizontalAlignment="Right"/></DockPanel><DataGrid x:Name="ProjectsGrid" Grid.Row="1" ItemsSource="{Binding Projects}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" Background="White"><DataGrid.Columns><DataGridCheckBoxColumn Header="All" Binding="{Binding IncludeInCopyAll}" Width="42"/><DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/><DataGridTextColumn Header="Repo" Binding="{Binding RepoUrl, UpdateSourceTrigger=PropertyChanged}" Width="2*"/><DataGridTextColumn Header="Site" Binding="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}" Width="2*"/><DataGridTextColumn x:Name="ExtraUrlColumn" Header="Extra" Binding="{Binding ExtraUrl, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/><DataGridCheckBoxColumn Header="Archived" Binding="{Binding IsArchived}" Width="70"/><DataGridTemplateColumn Header="Copy" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel><CheckBox Content="N" IsChecked="{Binding CopyName}" Margin="2"/><CheckBox Content="R" IsChecked="{Binding CopyRepo}" Margin="2"/><CheckBox Content="S" IsChecked="{Binding CopySite}" Margin="2"/><CheckBox Content="E" IsChecked="{Binding CopyExtra}" Margin="2"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Actions" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel><Button Content="Repo" Tag="{Binding RepoUrl}" Click="OpenUrl_Click"/><Button Content="Copy R" Tag="{Binding RepoUrl}" Click="CopyValue_Click"/><Button Content="Site" Tag="{Binding SiteUrl}" Click="OpenUrl_Click"/><Button Content="Copy S" Tag="{Binding SiteUrl}" Click="CopyValue_Click"/><Button Content="Extra" Tag="{Binding ExtraUrl}" Click="OpenUrl_Click"/><Button Content="Copy E" Tag="{Binding ExtraUrl}" Click="CopyValue_Click"/><Button Content="Row" Tag="{Binding}" Click="CopyRow_Click"/><Button Content="Del" Tag="{Binding}" Click="DeleteProject_Click"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Margin="4,8,4,0" Foreground="{StaticResource MutedBrush}" Text="Open buttons open. Copy buttons copy. Hiding Extra keeps its data."/></Grid></TabItem>
        <TabItem Header="Prompts"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Reusable modules" FontSize="15" FontWeight="SemiBold"/><Button Content="Add" HorizontalAlignment="Right" Click="AddModule_Click"/></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding PromptModules}" Margin="0,6"><ListBox.ItemTemplate><DataTemplate><Border Padding="5"><StackPanel><DockPanel><CheckBox IsChecked="{Binding IsEnabled}"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Width="190"/><Button Content="Up" Tag="{Binding}" Click="MoveModuleUp_Click"/><Button Content="Down" Tag="{Binding}" Click="MoveModuleDown_Click"/></DockPanel><TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Use {{project}}, {{repo}}, {{site}}, or {{extra}}. Unknown variables remain visible."/></Grid><Grid Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Compose" FontSize="15" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedPromptProject}" DisplayMemberPath="Name"/><WrapPanel><Button Content="Preview" Click="PreviewPrompt_Click"/><Button Content="Copy prompt" Click="ComposeCopy_Click"/><Button Content="Copy + project" Click="ComposeCopyProject_Click"/></WrapPanel></StackPanel><TextBox Grid.Row="1" Text="{Binding PromptPreview, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="3,8"/><TextBlock Grid.Row="2" Text="Recent prompts" FontWeight="SemiBold"/><ListBox Grid.Row="3" ItemsSource="{Binding RecentPrompts}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid></TabItem>
        <TabItem Header="Notes"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><DockPanel><TextBlock Text="Sticky notes" FontSize="15" FontWeight="SemiBold"/><Button Content="New" HorizontalAlignment="Right" Click="AddNote_Click"/></DockPanel><ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" DisplayMemberPath="Title" Margin="0,6"/></StackPanel><Grid Grid.Column="1" Margin="8,0,0,0" DataContext="{Binding SelectedNote}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Labels, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated labels"/></StackPanel><TextBox Grid.Row="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="3,8"/><WrapPanel Grid.Row="2"><CheckBox Content="Pinned" IsChecked="{Binding IsPinned}" Margin="6"/><Button Content="Copy note" Click="CopyNote_Click"/><Button Content="Archive / restore" Click="ArchiveNote_Click"/></WrapPanel></Grid></Grid></TabItem>
        <TabItem Header="Settings"><StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Local-first storage" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Data file" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox Text="{Binding DataFilePath, Mode=OneWay}" IsReadOnly="True"/><WrapPanel><Button Content="Open data folder" Click="OpenDataFolder_Click"/><Button Content="Export JSON" Click="Export_Click"/><Button Content="Import JSON" Click="Import_Click"/></WrapPanel><TextBlock Text="V1 stays focused on project clipboard, modular prompts, notes, adaptive window sizes, always-on-top, and JSON persistence." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,5"><DockPanel><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="Local JSON | no PowerToys fork dependency"/></DockPanel></Border>
  </Grid>
</Window>
